@page
@model SatDte.Web.Pages.AyudaModel
@{
    ViewData["Title"] = "Ayuda";
}
<div class="page-eyebrow">RECURSOS Y DOCUMENTACIÓN</div>
<h1 class="page-title">Ayuda del sistema</h1>
<p class="page-description">Información del estudiante, funcionamiento de la API e instrucciones generales.</p>
<div class="two-column">
    <section class="panel"><div class="panel-header"><span class="panel-step">i</span><div><h2>Información del estudiante</h2><p>Completa con tus datos antes de la entrega final.</p></div></div>
        <dl class="info-grid"><dt>Universidad</dt><dd>Universidad de San Carlos de Guatemala</dd><dt>Curso</dt><dd>Introducción a la Programación y Computación 2</dd><dt>Nombre</dt><dd><em>Pendiente: ingresar nombre</em></dd><dt>Carné</dt><dd><em>Pendiente: ingresar carné</em></dd><dt>Sección</dt><dd><em>Pendiente: ingresar sección</em></dd><dt>Versión</dt><dd>Release 1 / 4</dd></dl>
    </section>
    <section class="panel"><div class="panel-header"><span class="panel-step alt">?</span><div><h2>Documentación y API</h2><p>Material incluido con la solución</p></div></div>
        <ul class="rules-list"><li><strong>README.md:</strong> instalación y ejecución en Visual Studio.</li><li><strong>Documentacion/:</strong> arquitectura, estructura de clases y alcance de la primera entrega.</li><li><strong>Ejemplos/:</strong> archivos de carga y casos de prueba.</li><li><strong>Servicio HTTP:</strong> API independiente, accesible con Postman.</li></ul>
        <div class="api-preview"><span>GET</span> http://localhost:5175/api/sistema/estado</div>
        <div class="api-preview"><span>POST</span> http://localhost:5175/api/rtu/importar</div>
